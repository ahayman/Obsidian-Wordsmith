{
  "name": "obsidian-wordsmith",
  "version": "0.1.0",
  "description": "Obsidian plugin for finding synonyms and definitions of words",
  "main": "main.js",
  "dependencies": {
    "nspell": "^2.1.5"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "synonyms",
    "definitions",
    "thesaurus",
    "dictionary"
  ],
  "author": "Aaron Hayman",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@eslint/json": "^0.14.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^16.11.6",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^14.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "ts-jest": "^29.4.0",
    "tslib": "^2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
